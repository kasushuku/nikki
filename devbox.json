{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "github:nixos/nixpkgs/nixpkgs-unstable#dune",
    "pnpm@latest",
    "pkg-config",
    "libffi.dev",
    "zlib.dev",
    "gmp.dev",
    "github:nixos/nixpkgs/nixpkgs-unstable#openssl.dev",
    "github:nixos/nixpkgs/nixpkgs-unstable#libev",
  ],
 "env": {
  "PKG_CONFIG_PATH": "$PWD/.devbox/nix/profile/default/share/pkgconfig:$PWD/.devbox/nix/profile/default/lib/pkgconfig",
  "LIBRARY_PATH": "$PWD/.devbox/nix/profile/default/lib",
  "LD_LIBRARY_PATH": "$PWD/.devbox/nix/profile/default/lib"
  },
  "shell": {
    "init_hook": [
      "export DEVBOX_PROMPT_NAME='kasushuku_nikki'",
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1",
      ],
    },
  },
}
