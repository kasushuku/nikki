(rule
 (targets views.ml)
 (deps 
  (glob_files %{workspace_root}/web/views/*.html)
  %{workspace_root}/app/lib/gen_views.sh
  %{bin:dream_eml})
 (action
  (progn
   (with-stdout-to
    views.ml
    (bash "bash %{workspace_root}/app/lib/gen_views.sh %{workspace_root}/web/views/*.html" )))))
